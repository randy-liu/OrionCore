    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyName>OrionCore.API</AssemblyName>
    <PackageId>OrionCore.API</PackageId>
    <Authors>Jax Hu</Authors>
    <Company>Jax Hu</Company>
    <Product>OrionCore.API</Product>
    <Description>Orion for ASP.NET Core</Description>
    <Copyright>Copyright © 2020 Jax Hu Information Co.</Copyright>
    <RootNamespace>OrionCore.API</RootNamespace>
    <OutputType>Library</OutputType>
