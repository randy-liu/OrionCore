<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- 專案會在建置後產生 NuGet 包 -->
    <TargetFramework>net8.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>1.0.10</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <AssemblyName>OrionCore.Mvc</AssemblyName>
    <PackageId>OrionCore.Mvc</PackageId>
    <Authors>Jax Hu</Authors>
    <Company>Jax Hu</Company>
    <Product>OrionCore.Mvc</Product>
    <Description>Orion for ASP.NET Core</Description>
    <Copyright>Copyright © 2020 Jax Hu Information Co.</Copyright>
    <RootNamespace>Orion.Mvc</RootNamespace>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageIcon>orion_logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <!-- 預設為空，不包含 any local absolute paths -->
    <NugetPublishDir Condition="'$(NugetPublishDir)' == ''"></NugetPublishDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DocumentationFile>$(MSBuildProjectDirectory)\OrionCore.Mvc.xml</DocumentationFile>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>


  <ItemGroup>
    <Compile Remove="ModelBinder\DateTimeOffsetModelBinder.cs" />
  </ItemGroup>


  <ItemGroup>
    <None Remove="OCR-b.ttf" />
    <None Remove="UI\menus.xsd" />
    <None Include="orion_logo.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="OCR-b.ttf" />
    <EmbeddedResource Include="UI\menus.xsd" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrionCore.API\OrionCore.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>


 
  <Target Name="NugetPublish" AfterTargets="GenerateNuspec" Condition=" '$(Configuration)' == 'Release' ">
    <ItemGroup>
      <SymbolFiles Include="$(TargetDir)\..\*.symbols.nupkg" />
    </ItemGroup>    
    <Move SourceFiles="%(SymbolFiles.FullPath)" DestinationFiles="@(SymbolFiles -&gt; Replace('.symbols.nupkg', '.nupkg'))" />

    <!-- 僅當外部有指定發行目錄時才執行搬移 -->
    <ItemGroup Condition=" '$(NugetPublishDir)' != '' ">
      <NupkgFiles Include="$(TargetDir)\..\*.nupkg" />
    </ItemGroup>
    <Move Condition=" '$(NugetPublishDir)' != '' " SourceFiles="%(NupkgFiles.FullPath)" DestinationFolder="$(NugetPublishDir)" OverwriteReadOnlyFiles="True" />

    <Message Text="##################################################################" />
  </Target>

</Project>
